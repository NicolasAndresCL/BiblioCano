@startuml 1-casos-de-uso
' BiblioCano v0.2.0 · Diagrama de casos de uso
' Base: diagrama de Matías Toro (avance 19/11). Cambios en docs/control-de-cambios.md (C1, C2).
!theme plain
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
left to right direction
title Diagrama de casos de uso — BiblioCano

actor "Bibliotecario" as B
actor "Socio / Lector" as S

rectangle "Sistema de Gestión de Biblioteca (BiblioCano)" {
  usecase "Iniciar sesión" as UC1
  usecase "Gestionar libros\ny ejemplares" as UC2
  usecase "Consultar catálogo\nde libros" as UC3
  usecase "Registrar préstamo\nde libro" as UC4
  usecase "Validar estado\ndel socio" as UC4a
  usecase "Verificar disponibilidad\ndel ejemplar" as UC4b
  usecase "Registrar devolución\nde libro\n--\npuntos de extensión:\nentrega fuera de plazo" as UC5
  usecase "Calcular multa\npor retraso" as UC5a
}

B --> UC1
B --> UC2
B --> UC3
B --> UC4
B --> UC5
S --> UC3

UC4 ..> UC4a : <<include>>
UC4 ..> UC4b : <<include>>
UC5a ..> UC5 : <<extend>>

note right of UC5a
  condición: fecha de entrega
  posterior a la fecha esperada
  ($500 por día de atraso)
end note

note bottom of UC4
  Funcionalidad central implementada en Java.
  El socio pide el libro en el mesón: quien
  interactúa con el sistema es el bibliotecario.
end note
@enduml
