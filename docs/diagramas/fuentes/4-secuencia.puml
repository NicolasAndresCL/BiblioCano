@startuml 4-secuencia
' BiblioCano v0.2.0 · Diagrama de secuencia: «Registrar préstamo de libro»
' Rehecho sobre las clases reales (C12). Numeración igual a la del diagrama de comunicación.
' Código: ServicioPrestamos.registrarPrestamo y Bibliotecario.registrarPrestamo
!theme plain
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam sequenceMessageAlign left
skinparam maxMessageSize 220
skinparam ParticipantPadding 6
title Diagrama de secuencia — Registrar préstamo de libro

actor "Bibliotecario" as A
boundary ":VentanaPrincipal" as UI
control ":ServicioPrestamos" as SP
participant ":RepositorioSocios" as RS
participant ":RepositorioEjemplares" as RE
participant "b : Bibliotecario" as B
participant "s : Socio" as S
participant "e : Ejemplar" as E
participant "p : Prestamo" as P
participant ":RepositorioPrestamos" as RP

A -> UI ++ : 1: registrarPrestamo(idSocio, codigoBarra)
UI -> SP ++ : 1.1: registrarPrestamo(b, idSocio, codigoBarra)
SP -> RS ++ : 1.1.1: buscarPorId(idSocio)
return s
SP -> RE ++ : 1.1.2: buscarPorCodigo(codigoBarra)
return e

alt socio o ejemplar inexistente
  SP --> UI : RecursoNoEncontradoException
else ambos existen
  SP -> B ++ : 1.1.3: registrarPrestamo(s, e, hoy)
  B -> S ++ : 1.1.3.1: validarEstado(hoy)
  return habilitado : boolean

  alt not habilitado (multa impaga o préstamo vencido)
    B --> SP : SocioInhabilitadoException
    SP --> UI : SocioInhabilitadoException
  else habilitado
    B -> E ++ : 1.1.3.2: estaDisponible()
    return disponible : boolean

    alt not disponible (prestado o en mantenimiento)
      B --> SP : EjemplarNoDisponibleException
      SP --> UI : EjemplarNoDisponibleException
    else disponible
      create P
      B -> P ++ : 1.1.3.3: <<create>> Prestamo(s, e, b, hoy)
      P -> S ++ : 1.1.3.3.1: agregarPrestamo(p)
      deactivate S
      return p
      B -> E ++ : 1.1.3.4: cambiarEstado(PRESTADO)
      deactivate E
      return p
      SP -> RP ++ : 1.1.4: registrar(p)
      note right of RP
        Transacción: UPDATE ejemplar
        solo si sigue DISPONIBLE + INSERT.
        Si otro lo prestó antes, lanza
        EjemplarNoDisponibleException.
      end note
      return
      SP --> UI : p
    end
  end
end
deactivate SP
UI --> A : comprobante o motivo del rechazo
deactivate UI
@enduml
